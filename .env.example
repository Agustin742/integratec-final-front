# Copy to .env for local development. Never commit real .env files.
# All VITE_ variables are embedded into the public browser bundle at build time.
# Never place secrets, private keys, or credentials in this file.
# Changing any variable requires a new build or restarting the Vite dev server.
# See the "Public configuration" section in README.md for details.

# Environment name: development | test | production
VITE_APP_ENV=development

# Public REST API base URL (no trailing slash, no credentials, query, or hash)
# Local:      http://localhost:3000
# Test:       https://api.test.example.invalid
# Production: https://api.example.invalid (must use https://)
VITE_API_BASE_URL=http://localhost:3000

# Public Colyseus realtime WebSocket URL (no trailing slash, no credentials, query, or hash)
# Local:      ws://localhost:2567
# Test:       wss://realtime.test.example.invalid
# Production: wss://realtime.example.invalid (must use wss://)
VITE_REALTIME_URL=ws://localhost:2567
